{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moon Browser native plugin manifest, API 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion", "runtime", "entry", "contributes"],
  "properties": {
    "id": { "type": "string", "maxLength": 95, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.[A-Za-z0-9_.-]*[A-Za-z0-9_-]$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 2 },
    "runtime": { "const": "native" },
    "settingsPage": { "type": "string", "maxLength": 95, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.html$" },
    "networkRules": { "type": "string", "maxLength": 95, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.rules$" },
    "entry": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.[eE][xX][eE]$" },
    "permissions": {
      "type": "array",
      "items": { "enum": ["tabs.read", "lua.scripts.manage", "page.inspect", "history.manage", "network.filter", "bookmarks.manage", "downloads.manage", "siteData.read", "page.reading", "tabs.closed.manage", "privacy.clear", "taskManager.manage", "ui.commands", "tabs.organize", "privacy.privateWindow", "tabs.manage", "search.manage", "siteData.write", "tabs.session.manage", "bookmarks.transfer", "page.source", "popups.manage", "window.fullscreen", "page.save", "tabs.groups", "browser.defaultApp", "siteData.cookieDetails", "siteSettings.autoplay", "siteSettings.sound", "page.reader", "siteData.cacheWrite", "siteData.records", "siteData.databaseWrite", "window.appearance", "siteSettings.zoom", "downloads.preferences", "downloads.open", "siteData.cookieClear", "ui.settings", "siteSettings.notifications", "media.control", "network.capture"] }
    },
    "events": {
      "type": "array",
      "items": { "enum": ["tabs.changed"] }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description"],
          "properties": {
            "section": { "enum": ["general", "privacy", "developer", "extensions"], "default": "extensions" },
            "title": { "type": "string", "minLength": 1, "maxLength": 128 },
            "description": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "contains": { "required": ["tabDrop"], "properties": { "tabDrop": { "const": true } } },
          "minContains": 0,
          "maxContains": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "if": { "anyOf": [
              { "required": ["linkMenu"] },
              { "required": ["tabDrop"], "properties": { "tabDrop": { "const": true } } }
            ] },
            "then": { "not": { "anyOf": [
              { "required": ["menu"] },
              { "required": ["shortcut"] },
              { "required": ["siteMenu"], "properties": { "siteMenu": { "const": true } } },
              { "required": ["linkMenu", "tabDrop"], "properties": { "tabDrop": { "const": true } } },
              { "required": ["inspectElementMenu"] },
              { "required": ["highlightLinkMenu"] }
            ] } },
            "not": { "required": ["inspectElementMenu", "highlightLinkMenu"] },
            "properties": {
              "id": { "type": "string", "maxLength": 63, "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9_.-]*[A-Za-z0-9_-])?$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 255 },
              "interactive": { "type": "boolean" },
              "menu": { "enum": ["page", "library", "privacy", "developer", "extensions"] },
              "siteMenu": { "type": "boolean", "default": false },
              "linkMenu": { "enum": ["open", "copy", "bookmark"] },
              "inspectElementMenu": { "type": "string", "minLength": 1, "maxLength": 255 },
              "highlightLinkMenu": { "type": "string", "minLength": 1, "maxLength": 255 },
              "tabDrop": { "type": "boolean", "default": false },
              "shortcut": { "enum": ["Ctrl+H", "F9", "F11", "F12", "Ctrl+Shift+C", "Ctrl+Shift+E", "Ctrl+Shift+J", "Ctrl+D", "Ctrl+Shift+O", "Ctrl+J", "Ctrl+F", "Ctrl++", "Ctrl+-", "Ctrl+0", "Ctrl+Shift+T", "Ctrl+Shift+Delete", "Ctrl+Shift+M", "Ctrl+Shift+N", "Ctrl+U", "Ctrl+S", "Ctrl+Shift+B", "Ctrl+Shift+R", "Ctrl+B", "Ctrl+Shift+L", "Ctrl+Shift+A", "Ctrl+,"] }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contributes": { "required": ["settings"] } } },
      "then": { "required": ["settingsPage"] }
    },
    {
      "if": {
        "required": ["events"],
        "properties": { "events": { "contains": { "const": "tabs.changed" } } }
      },
      "then": {
        "required": ["permissions"],
        "properties": { "permissions": { "contains": { "const": "tabs.read" } } }
      }
    },
    {
      "if": {
        "properties": { "contributes": { "properties": { "commands": { "contains": { "required": ["inspectElementMenu"] } } } } }
      },
      "then": {
        "required": ["permissions"],
        "properties": {
          "permissions": { "contains": { "const": "page.inspect" } },
          "contributes": { "properties": { "commands": { "contains": { "required": ["inspectElementMenu"] }, "maxContains": 1 } } }
        }
      }
    },
    {
      "if": {
        "required": ["contributes"],
        "properties": { "contributes": { "required": ["commands"], "properties": { "commands": { "contains": { "required": ["highlightLinkMenu"] } } } } }
      },
      "then": {
        "required": ["permissions"],
        "properties": {
          "permissions": { "contains": { "const": "tabs.manage" } },
          "contributes": { "properties": { "commands": { "contains": { "required": ["highlightLinkMenu"] }, "maxContains": 1 } } }
        }
      }
    }
  ]
}
