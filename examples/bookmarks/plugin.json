{
  "id": "moon.bookmarks",
  "name": "书签",
  "version": "0.1.0",
  "apiVersion": 2,
  "runtime": "native",
  "entry": "MoonBookmarks.exe",
  "settingsPage": "bookmarks.html",
  "contributes": {
    "commands": [
      { "id": "open", "label": "管理书签", "shortcut": "Ctrl+Shift+O" },
      { "id": "save", "label": "将当前页加入书签", "shortcut": "Ctrl+D" }
    ]
  },
  "permissions": ["bookmarks.manage"]
}
