{
  "id": "moon.devtools",
  "name": "网页开发者工具",
  "version": "1.7.0",
  "apiVersion": 2,
  "runtime": "native",
  "entry": "MoonDevTools.exe",
  "settingsPage": "settings.html",
  "contributes": {
    "settings": {"section": "developer", "title": "开发者工具", "description": "设置检查器默认停靠在页面内或独立窗口。"},
    "commands": [
      {"id": "inspector", "label": "切换网页开发者工具", "menu": "developer", "shortcut": "F12"},
      {"id": "elements", "label": "拾取网页元素", "menu": "developer", "shortcut": "Ctrl+Shift+C", "inspectElementMenu": "检查元素"},
      {"id": "console", "label": "打开网页控制台", "menu": "developer", "siteMenu": true, "shortcut": "Ctrl+Shift+J"},
      {"id": "resources", "label": "查看网页资源和站点数据", "menu": "developer"},
      {"id": "viewport", "label": "切换响应式预览", "menu": "developer", "shortcut": "Ctrl+Shift+E"},
      {"id": "viewportPhone", "label": "以手机尺寸预览"},
      {"id": "hardReload", "label": "强制刷新网页", "menu": "developer", "shortcut": "Ctrl+Shift+R"},
      {"id": "window", "label": "在独立窗口打开开发者工具", "menu": "developer"},
      {"id": "dock", "label": "停靠开发者工具", "menu": "developer"},
      {"id": "settings", "label": "开发者工具设置", "menu": "developer"}
    ]
  },
  "permissions": ["page.inspect"]
}
