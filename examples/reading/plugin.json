{
  "id": "moon.reading",
  "name": "查找与缩放",
  "version": "0.1.0",
  "apiVersion": 2,
  "runtime": "native",
  "entry": "MoonReading.exe",
  "contributes": {
    "commands": [
      { "id": "find", "label": "页内查找", "shortcut": "Ctrl+F" },
      { "id": "increase", "label": "放大页面", "shortcut": "Ctrl++" },
      { "id": "decrease", "label": "缩小页面", "shortcut": "Ctrl+-" },
      { "id": "reset", "label": "重置页面缩放", "shortcut": "Ctrl+0" }
    ]
  },
  "permissions": ["page.reading"]
}
